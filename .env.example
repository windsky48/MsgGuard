# ==========================================================================
# 复制本文件为 .env 后按需修改（真实环境变量优先级高于本文件）
# python-dotenv 不是必需：项目内置了极简 .env 解析器（见 config.py）
# ==========================================================================

# ---------- QQ 机器人（开放平台「机器人管理」页面获取） ----------
QQ_APPID=1020000000
QQ_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QQ_PORT=8080
# 沙箱环境改为 true
QQ_SANDBOX=false
# 可选：填入机器人自身 user_openid，用于忽略自己发的消息
BOT_USER_OPENID=

# ---------- 阿里云内容审核（AccessKey 鉴权，非 Bearer Token） ----------
# 需求给定的变量名；同时兼容 ALIBABA_CLOUD_ACCESS_KEY_ID / ACCESS_KEY_ID
A_CLOUD_ACCESS_KEY_ID=LTAIxxxxxxxxxxxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 内容审核 API 的接入地域（北京）。可填 cn-beijing / cn-shanghai / cn-hangzhou 等
ALIBABA_CLOUD_REGION=cn-beijing
# 审核业务类型，便于在阿里云控制台按业务统计
GREEN_BIZ_TYPE=qq_group_guard
# 审核场景：porn=色情，terror=暴恐涉政
GREEN_SCENES=porn,terror
# 判定阈值：label != normal 且 rate >= 该值即判违规（0~1）
VIOLATION_RATE_THRESHOLD=0.8
# 请求体结构：auto（自动在 tasks/flat 间选择）| tasks | flat
GREEN_BODY_MODE=auto
# 单任务文本长度上限，超过自动分片（官方约 2000 字）
TEXT_CHUNK_SIZE=1800

# ---------- 审核接口稳定性（限流 / 重试） ----------
GREEN_API_MAX_RETRY=1
GREEN_API_RETRY_DELAY=1.0
GREEN_API_MIN_INTERVAL=0.25
GREEN_API_MAX_CONCURRENCY=2
GREEN_API_TIMEOUT=10.0
# 图片直连审核失败时，是否下载到本地再经 Extension.Uploader 上传换临时 URL
IMAGE_FALLBACK_UPLOAD=true
IMAGE_DOWNLOAD_TIMEOUT=10.0

# ---------- 处置策略 ----------
RECALL_LIMIT_SECONDS=120
MUTE_SECONDS=86400
KICK_ON_REPEAT=true
# ViolationsNum >= 该值 -> 踢出群聊（需求为 1，即第二次及以上踢出）
REPEAT_THRESHOLD=1

# ---------- 白名单 ----------
WHITELIST_ENABLED=true
WHITELIST_FILE=Whitelist.json
# 允许执行 #加白/#移白/#清零/#白名单 指令的管理员 user_openid（逗号分隔）
# 留空 = 指令全部禁用，只能手工编辑 Whitelist.json
WHITELIST_ADMINS=
# 加白时是否同时清零该成员的 ViolationsNum
WHITELIST_RESET_VIOLATIONS=true

# ---------- 存储与日志 ----------
# 相对路径按项目根目录解析
VIOLATIONS_FILE=ViolationsNum.json
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# ---------- 其它 ----------
# 总开关：false 时只记录日志不做任何处置
MODERATION_ENABLED=true
DEBUG=false